# 复制为 .env.local 后自行填写。每个角色必须是互不相同的 6 位数字。
# 不要把真实访问码提交到仓库。留空时，首次创建存储会随机生成，并写入已忽略的 .local-access-codes.json。
ACCESS_CODE_ADMIN=
ACCESS_CODE_CLIENT=
ACCESS_CODE_QH_CUSTOMER=
ACCESS_CODE_QH_ENGINEERING=
ACCESS_CODE_QH_CLEANING=
ACCESS_CODE_QH_SECURITY=
ACCESS_CODE_WD_SERVICE=

# 仅本地 http 开发时取消下一行注释，使登录 Cookie 不带 Secure。生产环境不要设置。
# LOCAL_TEST_MODE=true

# 设为 true 时，仅在存储为空的首次启动写入一条虚构示例日报。默认不导入任何历史数据。
DEMO_SEED=
